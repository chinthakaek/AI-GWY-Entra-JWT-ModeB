# Azure Entra ID (MSAL) — register an app in Azure Portal and fill these in
AZURE_CLIENT_ID=your-azure-app-client-id
AZURE_CLIENT_SECRET=your-azure-app-client-secret
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_REDIRECT_URI=http://localhost:5000/auth/callback

# Portkey Hybrid Gateway (running locally)
PORTKEY_GATEWAY_URL=http://localhost/v1
# Provider slug configured in Portkey admin — e.g. @groq-prod
PORTKEY_PROVIDER=@your-provider-slug
# Workspace is now read from the portkey_workspace claim in the Entra JWT — no env var needed

# Flask session secret — use a long random string in production
FLASK_SECRET_KEY=change-me-to-a-long-random-string
